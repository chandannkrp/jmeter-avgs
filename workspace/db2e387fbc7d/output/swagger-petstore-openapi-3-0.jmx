            <stringProp name="Argument.value">CHANGE_ME</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="petId" elementType="Argument">
            <stringProp name="Argument.name">petId</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="orderId" elementType="Argument">
